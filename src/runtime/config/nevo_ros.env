# ROS 2 middleware for the whole NEVO stack. Installed as /home/nevo/nevo_ros.env.
# Read by systemd (EnvironmentFile= in zenohd/nevo/nevo-mapping.service) and by
# the shells / scripts via:  set -a; source ~/nevo_ros.env; set +a
# Plain KEY=VALUE lines only (systemd syntax): no `export`, no quotes, no $VARS.
RMW_IMPLEMENTATION=rmw_zenoh_cpp
ROS_DOMAIN_ID=7
