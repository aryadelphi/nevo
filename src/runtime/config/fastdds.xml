<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastdds_profiles">
  <participant profile_name="participant_profile" is_default_profile="true">
    <rtps>
      <builtin>
        <useDNSv2>false</useDNSv2>
        <leasesDuration>
          <sec>12</sec>
        </leasesDuration>
        <initial_announce_count>5</initial_announce_count>
      </builtin>
      <useBuiltinTransports>true</useBuiltinTransports>
      <socketTransportBufferSize>
        <sendBufferSize>10485760</sendBufferSize>
        <receiveBufferSize>10485760</receiveBufferSize>
      </socketTransportBufferSize>
    </rtps>
  </participant>
</profiles>
