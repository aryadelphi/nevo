[Unit]
Description=NEVO Navigation Stack
Requires=zenohd.service
After=network.target zenohd.service

[Service]
Type=simple
User=nevo
Group=nevo
WorkingDirectory=/home/nevo
EnvironmentFile=/home/nevo/nevo_ros.env
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash /home/nevo/nevo_launch_robot.sh nav
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nevo-nav

[Install]
WantedBy=multi-user.target
