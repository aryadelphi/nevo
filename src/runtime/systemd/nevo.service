[Unit]
Description=NEVO Navigation Stack
After=network.target

[Service]
Type=simple
User=nevo
Group=nevo
WorkingDirectory=/home/nevo
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=file:///home/nevo/fastdds.xml
Environment=ROS_DOMAIN_ID=7
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash /home/nevo/nevo_launch_robot.sh nav
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nevo-nav

[Install]
WantedBy=multi-user.target
