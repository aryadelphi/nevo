[Unit]
Description=NEVO Mapping Stack
After=network.target

[Service]
Type=simple
User=rspx1
Group=rspx1
WorkingDirectory=/home/rspx1
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=file:///home/rspx1/fastdds.xml
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/rspx1/nevo_ws/install/setup.bash && exec ros2 launch nevo_bot hw_mapping.launch.py robot_id:=TFRB2 ui_id:=TFUI2'
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nevo-mapping

[Install]
WantedBy=multi-user.target
