[Unit]
Description=NEVO Mapping Stack
Requires=zenohd.service
After=network.target zenohd.service

[Service]
Type=simple
User=nevo
Group=nevo
WorkingDirectory=/home/nevo
EnvironmentFile=/home/nevo/nevo_ros.env
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/nevo/nevo_ws/install/setup.bash && exec ros2 launch nevo_bot hw_mapping.launch.py robot_id:=TFRB2 ui_id:=TFUI2'
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nevo-mapping

[Install]
WantedBy=multi-user.target
