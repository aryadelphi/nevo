<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Physical camera mounting point (Mirrored to the rear) -->
    <joint name="c310_camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="c310_camera_link"/>
        <!-- 
          x="-0.55": Moved to the back of the chassis (opposite of depth camera's 0.55)
          z="0.14": Exact same height as depth camera
          pitch="-0.15": Exact same tilt
          yaw="${pi}": Rotated exactly 180 degrees to face backwards
        -->
        <origin xyz="-0.05 0 0.04" rpy="0 0 ${pi}"/> 
    </joint>

    <link name="c310_camera_link">
        <visual>
            <geometry>
                <box size="0.03 0.08 0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

    <!-- Optical frame for ROS mathematical conventions (Z forward, X right, Y down) -->
    <joint name="c310_camera_optical_joint" type="fixed">
        <parent link="c310_camera_link"/>
        <child link="c310_camera_link_optical"/>
        <!-- This stays exactly the same, as it's relative to the physical link above -->
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="c310_camera_link_optical"></link>

    <gazebo reference="c310_camera_link">
        <sensor name="c310_camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>15</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>B8G8R8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <plugin name="c310_camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>c310_camera_link_optical</frame_name>
                <ros>
                    <argument>camera_info:=/c310/camera_info</argument>
                    <argument>image_raw:=/c310/image_raw</argument>
                </ros>
            </plugin>
        </sensor>
    </gazebo>

</robot>
