<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    Gazebo Harmonic world (was Gazebo Classic).
    The dock's AprilTag now uses the package texture through the
    model://nevo_bot/... URI, which resolves because nevo_bot exports
    gazebo_model_path in package.xml (picked up by ros_gz_sim's
    gz_sim.launch.py).
  -->
  <world name="default">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <!-- UserCommands provides the /world/default/create service used by ros_gz_sim -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple charging dock model with AprilTag -->
    <model name="charging_dock">
      <static>true</static>
      <pose>-1.8 0.40 0 0 0 0</pose>

      <!-- Dock body -->
      <link name="body">
        <pose>0 0 0.15 0 0 0</pose>
        <visual name="base">
          <geometry>
            <box>
              <size>0.50 0.30 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.50 0.30 0.30</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Post holding the tag -->
      <link name="post">
        <pose>0.25 0 0.30 0 0 0</pose>
        <visual name="post_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.40</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- AprilTag visual on post, facing +X (towards robot spawn) -->
      <link name="tag">
        <pose>0.25 0 0.55 0 0 0</pose>
        <visual name="tag_visual">
          <geometry>
            <box>
              <size>0.001 0.20 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://nevo_bot/meshes/tag36h11_0.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <joint name="body_post_joint" type="fixed">
        <parent>body</parent>
        <child>post</child>
      </joint>
      <joint name="post_tag_joint" type="fixed">
        <parent>post</parent>
        <child>tag</child>
      </joint>
    </model>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
  </world>
</sdf>
