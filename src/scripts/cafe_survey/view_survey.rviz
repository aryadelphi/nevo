Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Survey cloud (cloud.ply)
      Enabled: true
      Topic:
        Value: /survey_cloud
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Alpha: 0.6
      Decay Time: 0
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Alpha: 1
    - Class: rviz_default_plugins/DepthCloud
      Name: Kinect live
      Enabled: true
      Topic:
        Value: /depth/image_raw
      Depth Map Transport Hint: compressedDepth
      Color: 255; 255; 255
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
      Queue Size: 5
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan_filtered
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Size (m): 0.04
      Style: Flat Squares
      Decay Time: 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: odom
    Background Color: 30; 30; 34
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: 3.5
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 3.9
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1500
  Height: 950
